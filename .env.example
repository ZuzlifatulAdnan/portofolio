# Salin ke .env. Aplikasi otomatis membacanya; variabel terminal tetap diutamakan.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Kosong untuk lokal agar localhost dan 127.0.0.1 sama-sama dapat dipakai.
# Untuk produksi, isi origin HTTPS sesuai domain.
APP_ORIGIN=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_cms
DB_USER=root
DB_PASSWORD=

# Tes integrasi membuat lalu menghapus database terpisah (portfolio_cms_test_*).
# Gunakan akun MySQL lokal yang memiliki izin CREATE/DROP DATABASE.
TEST_DB_USER=root
TEST_DB_PASSWORD=
# Jangan simpan ADMIN_PASSWORD di sini; create-admin menyediakan prompt tersembunyi.
