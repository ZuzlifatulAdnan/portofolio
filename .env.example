# Salin ke .env. Aplikasi otomatis membacanya; variabel terminal tetap diutamakan.
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# Kosong untuk lokal agar localhost dan 127.0.0.1 sama-sama dapat dipakai.
# Untuk produksi, isi origin HTTPS sesuai domain.
APP_ORIGIN=
# Hanya isi loopback jika memakai reverse proxy tepercaya di komputer yang sama.
# Jika kosong, X-Forwarded-For diabaikan agar batas permintaan tidak mudah dipalsukan.
TRUST_PROXY=
# MFA: wajib untuk produksi. Gunakan kunci acak 32 byte base64 dan backup privat.
# Untuk lokal, kunci dibuat di storage/mfa.key saat setup MFA pertama kali.
MFA_ENCRYPTION_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portfolio_cms
DB_USER=root
DB_PASSWORD=

# Tes integrasi membuat lalu menghapus database terpisah (portfolio_cms_test_*).
# Gunakan akun MySQL lokal yang memiliki izin CREATE/DROP DATABASE.
TEST_DB_USER=root
TEST_DB_PASSWORD=
# Terjemahan otomatis opsional. Kosong = belum diaktifkan; tidak ada teks dikirim.
# Pilih google atau libretranslate setelah memiliki layanan yang sesuai.
TRANSLATION_PROVIDER=
GOOGLE_TRANSLATE_API_KEY=
# LibreTranslate harus menyediakan pasangan bahasa ID/EN.
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
# Jangan simpan ADMIN_PASSWORD di sini; create-admin menyediakan prompt tersembunyi.
